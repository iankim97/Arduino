#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// 주소 0x27, 20열 4행 설정
LiquidCrystal_I2C lcd(0x27, 20, 4);

const int PIN_P_CDS = 6;    
const int PIN_N_CDS = 7;    
const int OUT_P_RELAY = 38; 
const int OUT_N_RELAY = 39; 

const float REF_VOLT = 0.25; 

// 판정 상태 문자열 변수
String pStatus = "[  ]";
String nStatus = "[  ]";

float calculateVolt(int adcValue) {
  return (adcValue * 5.0) / 1023.0;
}

void setup() {
  Serial.begin(9600);
  
  lcd.init();         
  lcd.backlight();    
  
  lcd.setCursor(0, 0);
  lcd.print("=== FA-DUINO READY ===");
  lcd.setCursor(0, 1);
  lcd.print("   SYSTEM MONITORING   ");
  lcd.setCursor(0, 2);
  lcd.print("   REF VOLT: 0.25V     ");
  delay(2000);
  lcd.clear();
}

void loop() {
  int pAdc = analogRead(PIN_P_CDS);
  int nAdc = analogRead(PIN_N_CDS);
  
  float pCdsVolt = calculateVolt(pAdc);
  float nCdsVolt = calculateVolt(nAdc);

  // P측 출력 및 판정
  if (pCdsVolt > REF_VOLT) {
    digitalWrite(OUT_P_RELAY, HIGH);
    pStatus = "[ON]";
  } else {
    digitalWrite(OUT_P_RELAY, LOW);
    pStatus = "[  ]";
  }
  
  // N측 출력 및 판정
  if (nCdsVolt > REF_VOLT) {
    digitalWrite(OUT_N_RELAY, HIGH);
    nStatus = "[ON]";
  } else {
    digitalWrite(OUT_N_RELAY, LOW);
    nStatus = "[  ]";
  }

  // 1번째 줄: P-type 현재 전압 및 판정
  lcd.setCursor(0, 0); 
  lcd.print("P-type: "); 
  lcd.print(pCdsVolt, 2); 
  lcd.print("V "); 
  lcd.print(pStatus);
  lcd.print("   "); // 잔상 제거용 여백

  // 2번째 줄: P-set value 기준 전압
  lcd.setCursor(0, 1); 
  lcd.print("P-set value: "); 
  lcd.print(REF_VOLT, 2); 
  lcd.print("V ");

  // 3번째 줄: N-type 현재 전압 및 판정
  lcd.setCursor(0, 2); 
  lcd.print("N-type: "); 
  lcd.print(nCdsVolt, 2); 
  lcd.print("V "); 
  lcd.print(nStatus);
  lcd.print("   "); // 잔상 제거용 여백

  // 4번째 줄: N-set value 기준 전압
  lcd.setCursor(0, 3); 
  lcd.print("N-set value: "); 
  lcd.print(REF_VOLT, 2); 
  lcd.print("V ");

  // 시리얼 모니터 출력
  Serial.print("P:"); Serial.print(pCdsVolt, 2); Serial.print("V "); Serial.print(pStatus);
  Serial.print(" | N:"); Serial.print(nCdsVolt, 2); Serial.print("V "); Serial.print(nStatus);
  Serial.print(" | REF:"); Serial.println(REF_VOLT);

  delay(300); 
}
