#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// 주소 0x27, 20열 4행 설정
LiquidCrystal_I2C lcd(0x27, 20, 4);

const int PIN_P_CDS = 6;    
const int PIN_N_CDS = 7;    
const int OUT_P_RELAY = 38; 
const int OUT_N_RELAY = 39; 

const float REF_VOLT = 0.25; 

float calculateVolt(int adcValue) {
  return (adcValue * 5.0) / 1023.0;
}

void setup() {
  Serial.begin(9600);
  
  // ★ 이 부분을 가장 범용적인 초기화 코드로 수정했습니다 ★
  lcd.init();         // 라이브러리 기본 초기화 함수 사용
  lcd.backlight();    // 백라이트 켜기
  
  lcd.setCursor(0, 0);
  lcd.print("=== FA-DUINO READY ===");
  lcd.setCursor(0, 1);
  lcd.print("  SYSTEM MONITORING   ");
  lcd.setCursor(0, 2);
  lcd.print("  REF VOLT: 0.25V     ");
  delay(2000);
  lcd.clear();
}

void loop() {
  int pAdc = analogRead(PIN_P_CDS);
  int nAdc = analogRead(PIN_N_CDS);
  
  float pCdsVolt = calculateVolt(pAdc);
  float nCdsVolt = calculateVolt(nAdc);

  if (pCdsVolt > REF_VOLT) digitalWrite(OUT_P_RELAY, HIGH);
  else digitalWrite(OUT_P_RELAY, LOW);
  
  if (nCdsVolt > REF_VOLT) digitalWrite(OUT_N_RELAY, HIGH);
  else digitalWrite(OUT_N_RELAY, LOW);

  // LCD 출력 위치 강제 지정
  lcd.setCursor(0, 0); lcd.print("   [ PN TESTER ]    ");
  lcd.setCursor(0, 1); lcd.print("   P-type: "); lcd.print(pCdsVolt, 2); lcd.print("V    "); 
  lcd.setCursor(0, 2); lcd.print("   N-type: "); lcd.print(nCdsVolt, 2); lcd.print("V    "); 
  lcd.setCursor(0, 3); lcd.print("   Set-value: "); lcd.print(REF_VOLT, 2); lcd.print("V ");

  Serial.print("P:"); Serial.print(pCdsVolt, 2);
  Serial.print("V | N:"); Serial.print(nCdsVolt, 2);
  Serial.print("V | REF:"); Serial.println(REF_VOLT);

  delay(300); 
}
