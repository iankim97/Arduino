#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// 주소 0x27, 20열 4행 설정
LiquidCrystal_I2C lcd(0x27, 20, 4);

const int PIN_P_CDS = 6;    
const int PIN_N_CDS = 7;    
const int OUT_P_RELAY = 38; 
const int OUT_N_RELAY = 39; 

// ★ P측과 N측 설정 전압(Set Value)을 각각 다르게 지정 ★
const float P_REF_VOLT = 1.00; // P측 기준 전압
const float N_REF_VOLT = 1.00; // N측 기준 전압 (필요한 값으로 변경 가능)

// 판정 상태 문자열 변수
String pStatus = "[  ]";
String nStatus = "[  ]";

float calculateVolt(int adcValue) {
  return (adcValue * 5.0) / 1023.0;
}

void setup() {
  Serial.begin(9600);
  
  lcd.init();         
  lcd.backlight();    
  
  lcd.setCursor(0, 0);
  lcd.print("=====PN tester=====");
  lcd.setCursor(0, 1);
  lcd.print("   System initial  ");
    lcd.setCursor(0, 2);
  lcd.print("                   ");
  lcd.setCursor(0, 3);
  lcd.print("Foreworks / 26-0828");
  delay(3000);
  lcd.clear();
}

void loop() {
  int pAdc = analogRead(PIN_P_CDS);
  int nAdc = analogRead(PIN_N_CDS);
  
  float pCdsVolt = calculateVolt(pAdc);
  float nCdsVolt = calculateVolt(nAdc);

  // 1. P측 출력 및 판정 (P_REF_VOLT와 비교)
  if (pCdsVolt > P_REF_VOLT) {
    digitalWrite(OUT_P_RELAY, HIGH);
    pStatus = "[ON]";
  } else {
    digitalWrite(OUT_P_RELAY, LOW);
    pStatus = "[  ]";
  }
  
  // 2. N측 출력 및 판정 (N_REF_VOLT와 비교)
  if (nCdsVolt > N_REF_VOLT) {
    digitalWrite(OUT_N_RELAY, HIGH);
    nStatus = "[ON]";
  } else {
    digitalWrite(OUT_N_RELAY, LOW);
    nStatus = "[  ]";
  }

  // 3. LCD 출력
  // 1번째 줄: P-type 현재 전압 및 [ON]/[  ] 판정
  lcd.setCursor(0, 0); 
  lcd.print("P-type: "); 
  lcd.print(pCdsVolt, 2); 
  lcd.print("V ");  
  lcd.print(pStatus);
  lcd.print("   ");

  // 2번째 줄: P-set value 기준 전압 표시
  lcd.setCursor(0, 1); 
  lcd.print(" -set value: "); 
  lcd.print(P_REF_VOLT, 2); 
  lcd.print("V ");

  // 3번째 줄: N-type 현재 전압 및 [ON]/[  ] 판정
  lcd.setCursor(0, 2); 
  lcd.print("N-type: "); 
  lcd.print(nCdsVolt, 2); 
  lcd.print("V "); 
  lcd.print(nStatus);
  lcd.print("   ");

  // 4번째 줄: N-set value 기준 전압 표시
  lcd.setCursor(0, 3); 
  lcd.print(" -set value: "); 
  lcd.print(N_REF_VOLT, 2); 
  lcd.print("V ");

  // 시리얼 모니터 출력
  Serial.print("P:"); Serial.print(pCdsVolt, 2); Serial.print("V "); Serial.print(pStatus); Serial.print(" (SV:"); Serial.print(P_REF_VOLT, 2); Serial.print("V)");
  Serial.print(" | N:"); Serial.print(nCdsVolt, 2); Serial.print("V "); Serial.print(nStatus); Serial.print(" (SV:"); Serial.print(N_REF_VOLT, 2); Serial.println("V)");

  delay(300); 
}
