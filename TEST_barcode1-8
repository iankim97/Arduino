<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>Barcode Label (001~008) - A4</title>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm 12mm 6mm 12mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, "Noto Sans KR", sans-serif;
    }
    body {
      background-color: #fff;
      display: flex;
      justify-content: center;
    }
    .page-container {
      width: 186mm;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5mm 8mm;
    }
    .label-box {
      border: 1px dashed #bbb;
      padding: 4mm 6mm 3mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 32mm;
      text-align: center;
      background: #fff;
    }
    .top-text {
      font-size: 15.5pt;
      font-weight: bold;
      letter-spacing: 0.5px;
      margin-bottom: 1.5mm;
    }
    .barcode-svg {
      width: 60mm;
      height: 15mm;
    }
    .footer-desc {
      font-size: 6.5pt;
      color: #333;
      margin-top: 1.5mm;
      white-space: nowrap;
    }
    @media print {
      body { margin: 0; }
      .label-box { border-color: #ddd; }
    }
  </style>
</head>
<body>

<div class="page-container" id="container"></div>

<script>
  const container = document.getElementById('container');

  for (let i = 1; i <= 8; i++) {
    const numStr = String(i).padStart(3, '0');
    
    ['CST', 'LOT'].forEach(prefix => {
      const code = `${prefix}-${numStr}`;
      
      const box = document.createElement('div');
      box.className = 'label-box';
      box.innerHTML = `
        <div class="top-text">${code}</div>
        <svg id="bc-${code}" class="barcode-svg"></svg>
        <div class="footer-desc">Code 39 start/stop included as *${code}*</div>
      `;
      container.appendChild(box);

      JsBarcode(`#bc-${code}`, code, {
        format: "CODE39",
        width: 1.5,
        height: 50,
        displayValue: false,
        margin: 0
      });
    });
  }
</script>
</body>
</html>
